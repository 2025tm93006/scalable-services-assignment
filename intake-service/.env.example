# Export these in this service's terminal; Spring Boot does not auto-load this file.
SERVER_PORT=8081
# Relative to the directory where Java is started; run from the repository root.
# Use an absolute path when starting Intake from different directories.
DB_URL='jdbc:h2:file:./data/intake'
DB_USERNAME=intake_user
DB_PASSWORD=intake_local_demo
DB_DRIVER=org.h2.Driver
DDL_AUTO=update
