# Export these in this service's terminal; Spring Boot does not auto-load this file.
SERVER_PORT=8084
DB_URL='jdbc:h2:file:./data/release'
DB_USERNAME=release_user
DB_PASSWORD=release_local_demo
DB_DRIVER=org.h2.Driver
DDL_AUTO=update

# Quarantine is the authority on a file's state, so a release is verified against it.
# Verification is a read, so it is safe to retry; if Quarantine never answers, the release
# is refused with 503 rather than granted on the caller's word.
QUARANTINE_BASE_URL=http://localhost:8082
QUARANTINE_CONNECT_TIMEOUT_MILLIS=300
QUARANTINE_READ_TIMEOUT_MILLIS=2000
QUARANTINE_MAX_ATTEMPTS=3
QUARANTINE_RETRY_BASE_MILLIS=100
QUARANTINE_RETRY_JITTER_MILLIS=100
