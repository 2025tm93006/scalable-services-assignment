# Copy to .env for local customization. Do not commit .env or real credentials.
# Docker Compose loads this file automatically only after it is copied to .env.

# Host ports. Increase these if 8081-8084 are already occupied.
INTAKE_PORT=8081
QUARANTINE_PORT=8082
SCANNER_PORT=8083
RELEASE_PORT=8084

# Optional overrides for the health and e2e scripts when host ports are changed.
# INTAKE_URL=http://localhost:8081
# QUARANTINE_URL=http://localhost:8082
# SCANNER_URL=http://localhost:8083
# RELEASE_URL=http://localhost:8084

# Container databases. Leave passwords empty for local demonstration or supply
# values through a secret manager/CI integration; do not store real secrets here.
INTAKE_DB_USERNAME=intake_user
INTAKE_DB_PASSWORD=
SCANNER_DB_USERNAME=scanner_user
SCANNER_DB_PASSWORD=
QUARANTINE_DB_USERNAME=quarantine_user
QUARANTINE_DB_PASSWORD=
RELEASE_DB_USERNAME=release_user
RELEASE_DB_PASSWORD=
DDL_AUTO=update

# Optional inter-service URLs. Defaults use Docker Compose service names.
# SCANNER_BASE_URL=http://scanner-service:8083
# QUARANTINE_BASE_URL=http://quarantine-service:8082

# Scanner and resilience configuration.
SCANNER_SLOW_MILLIS=2000
MAX_CONCURRENT_SCANS=2
SCANNER_CB_ENABLED=false
