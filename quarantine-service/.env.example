# Export these in this service's terminal; Spring Boot does not auto-load this file.
SERVER_PORT=8082
DB_URL='jdbc:h2:file:./data/quarantine'
DB_USERNAME=quarantine_user
DB_PASSWORD=quarantine_local_demo
DB_DRIVER=org.h2.Driver
DDL_AUTO=update

# Scanner capacity: this many scans may run at once; the rest get 409.
MAX_CONCURRENT_SCANS=2

# Reclaim sweep for the rows a killed process leaves behind. slot-stale-millis must
# stay above SCANNER_READ_TIMEOUT_MILLIS x SCANNER_MAX_ATTEMPTS, or the sweep can free
# a slot whose scan is still entitled to finish.
QUARANTINE_RECLAIM_ENABLED=true
QUARANTINE_SLOT_STALE_MILLIS=60000
QUARANTINE_RECLAIM_INTERVAL_MILLIS=10000

# The Scanner service dependency and its resilience budget.
SCANNER_BASE_URL=http://localhost:8083
SCANNER_CONNECT_TIMEOUT_MILLIS=300
SCANNER_READ_TIMEOUT_MILLIS=5000
SCANNER_MAX_ATTEMPTS=3
SCANNER_RETRY_BASE_MILLIS=100
SCANNER_RETRY_JITTER_MILLIS=100

# Circuit breaker, the Challenge 3A bonus. Disabled by default: with it on, once
# SCANNER_CB_FAILURE_THRESHOLD calls have each spent their whole retry budget the circuit
# opens and further scans are refused instantly until the cooldown has passed.
SCANNER_CB_ENABLED=false
SCANNER_CB_FAILURE_THRESHOLD=3
SCANNER_CB_OPEN_MILLIS=4000
