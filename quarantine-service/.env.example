# Export these in this service's terminal; Spring Boot does not auto-load this file.
SERVER_PORT=8082
DB_URL='jdbc:h2:file:./data/quarantine'
DB_USERNAME=quarantine_user
DB_PASSWORD=quarantine_local_demo
DB_DRIVER=org.h2.Driver
DDL_AUTO=update

# Scanner capacity: this many scans may run at once; the rest get 409.
MAX_CONCURRENT_SCANS=2

# The Scanner service dependency and its resilience budget.
SCANNER_BASE_URL=http://localhost:8083
SCANNER_CONNECT_TIMEOUT_MILLIS=300
SCANNER_READ_TIMEOUT_MILLIS=5000
SCANNER_MAX_ATTEMPTS=3
SCANNER_RETRY_BASE_MILLIS=100
SCANNER_RETRY_JITTER_MILLIS=100
